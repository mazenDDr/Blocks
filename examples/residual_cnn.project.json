          "stateRef": null,
          "sharedWith": null
        },
        {
          "id": "relu_a",
          "type": "pytorch.nn.relu",
          "version": "1.0.0",
          "config": {},
          "stateRef": null,
          "sharedWith": null
        },
        {
          "id": "conv_b",
          "type": "pytorch.nn.conv2d",
          "version": "1.0.0",
          "config": {
            "out_channels": {
              "$param": "channels"
            },
            "kernel_size": [
              3,
              3
            ],
            "padding": [
              1,
              1
            ]
          },
          "stateRef": null,
          "sharedWith": null
        },
        {
          "id": "skip_add",
          "type": "tensor.add",
          "version": "1.0.0",
          "config": {},
          "stateRef": null,
          "sharedWith": null
        },
        {
          "id": "relu_out",
          "type": "pytorch.nn.relu",
          "version": "1.0.0",
          "config": {},
          "stateRef": null,
