        },
        {
          "id": "skip_add_output__relu_out_input",
          "kind": "tensor",
          "from": {
            "node": "skip_add",
            "port": "output"
          },
          "to": {
            "node": "relu_out",
            "port": "input"
          }
        }
      ],
      "reduction": null
    }
  ],
  "training": {
    "seed": 0,
    "deterministic": true,
    "epochs": 3,
    "max_optimizer_steps": null,
