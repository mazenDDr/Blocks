    },
    {
      "id": "res1",
      "type": "core.composite",
      "version": "1.0.0",
      "config": {
        "module": "residual_block",
        "version": "1.0.0",
        "args": {
          "channels": 8
        },
        "share": "clone"
      },
      "stateRef": null
    },
    {
      "id": "res2",
      "type": "core.composite",
      "version": "1.0.0",
      "config": {
        "module": "residual_block",
        "version": "1.0.0",
        "args": {
          "channels": 8
        },
        "share": "clone"
