      "type": "pytorch.nn.conv2d",
      "version": "1.0.0",
      "config": {
        "out_channels": 8,
        "padding": [
          1,
          1
        ]
      },
      "stateRef": null
    },
    {
      "id": "stem_act",
      "type": "pytorch.nn.relu",
      "version": "1.0.0",
      "config": {},
