{
  "schemaVersion": "1.0.0",
  "graphKind": "agent",
  "backend": "langgraph",
  "nodes": [
    {
      "id": "recall",
      "type": "agent.memory_select",
      "version": "1.0.0",
      "config": {
        "policy": "mine",
        "output_field": "recalled"
      },
      "stateRef": null
    },
    {
      "id": "tally",
      "type": "agent.set_state",
      "version": "1.0.0",
      "config": {
        "assignments": [
          {
            "field": "count",
            "kind": "length",
            "source": "recalled"
          }
        ]
      },
      "stateRef": null
    },
    {
      "id": "answer",
      "type": "agent.set_state",
      "version": "1.0.0",
      "config": {
        "assignments": [
          {
            "field": "answer",
            "kind": "template",
            "template": "SYNTHETIC: I recalled {count} earlier note(s) of yours before storing this one."
          }
        ]
      },
      "stateRef": null
    },
    {
      "id": "remember",
      "type": "agent.memory_write",
      "version": "1.0.0",
      "config": {
        "target": "long_term",
        "mode": "direct",
        "scope": "user",
        "namespace": "notes",
        "kind": "episodic",
        "text": "{note}",
        "generated": false,
        "evidence": "request input",
        "max_chars": 500
      },
      "stateRef": null
    }
  ],
  "edges": [
    {
      "id": "START__recall",
      "kind": "control",
      "from": {
        "node": "START",
        "port": "out"
      },
      "to": {
        "node": "recall",
        "port": "in"
      }
    },
    {
      "id": "recall__tally",
      "kind": "control",
      "from": {
        "node": "recall",
        "port": "out"
      },
      "to": {
        "node": "tally",
        "port": "in"
      }
    },
    {
      "id": "tally__answer",
      "kind": "control",
      "from": {
        "node": "tally",
        "port": "out"
      },
      "to": {
        "node": "answer",
        "port": "in"
      }
    },
    {
      "id": "answer__remember",
      "kind": "control",
      "from": {
        "node": "answer",
        "port": "out"
      },
      "to": {
        "node": "remember",
        "port": "in"
      }
    },
    {
      "id": "remember__END",
      "kind": "control",
      "from": {
        "node": "remember",
        "port": "out"
      },
      "to": {
        "node": "END",
        "port": "in"
      }
    }
  ],
  "agent": {
    "state": [
      {
        "name": "note",
        "type": "text",
        "reducer": {
          "kind": "replace"
        },
        "scope": "turn",
        "description": ""
      },
      {
        "name": "recalled",
        "type": "records",
        "reducer": {
          "kind": "replace"
        },
        "scope": "turn",
        "description": ""
      },
      {
        "name": "count",
        "type": "integer",
        "reducer": {
          "kind": "replace"
        },
        "scope": "turn",
        "description": "",
        "default": 0
      },
      {
        "name": "answer",
        "type": "text",
        "reducer": {
          "kind": "replace"
        },
        "scope": "turn",
        "description": ""
      }
    ],
    "policies": [
      {
        "id": "mine",
        "query": "{note}",
        "embeddings": {
          "provider": "local_hash",
          "dimension": 64
        },
        "stages": [
          {
            "id": "take",
            "op": "retrieve",
            "config": {
              "sources": [
                "long_term"
              ],
              "scopes": [
                "user"
              ],
              "namespaces": [
                "notes"
              ],
              "method": "recency",
              "k": 5
            }
          },
          {
            "id": "budget",
            "op": "budget",
            "config": {
              "max_tokens": 256,
              "order": "chronological"
            }
          }
        ]
      }
    ],
    "limits": {
      "maxSteps": 12,
      "maxSeconds": 30,
      "maxModelCalls": 1,
      "maxTokens": 4096
    }
  }
}
