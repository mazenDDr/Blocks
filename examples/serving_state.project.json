{
  "schemaVersion": "1.0.0",
  "graphKind": "agent",
  "backend": "langgraph",
  "nodes": [
    {
      "id": "tick",
      "type": "agent.set_state",
      "version": "1.0.0",
      "config": {
        "assignments": [
          {
            "field": "n",
            "kind": "increment",
            "by": 1
          },
          {
            "field": "history",
            "kind": "append_item",
            "source": "question"
          },
          {
            "field": "turns",
            "kind": "increment",
            "by": 1
          }
        ]
      },
      "stateRef": null
    },
    {
      "id": "answer",
      "type": "agent.set_state",
      "version": "1.0.0",
      "config": {
        "assignments": [
          {
            "field": "answer",
            "kind": "template",
            "template": "{question}: {n}/{turns}"
          }
        ]
      },
      "stateRef": null
    }
  ],
  "edges": [
    {
      "id": "START__tick",
      "kind": "control",
      "from": {
        "node": "START",
        "port": "out"
      },
      "to": {
        "node": "tick",
        "port": "in"
      }
    },
    {
      "id": "tick__answer",
      "kind": "control",
      "from": {
        "node": "tick",
        "port": "out"
      },
      "to": {
        "node": "answer",
        "port": "in"
      }
    },
    {
      "id": "answer__END",
      "kind": "control",
      "from": {
        "node": "answer",
        "port": "out"
      },
      "to": {
        "node": "END",
        "port": "in"
      }
    }
  ],
  "agent": {
    "state": [
      {
        "name": "question",
        "type": "text",
        "reducer": {
          "kind": "replace"
        },
        "scope": "turn",
        "description": ""
      },
      {
        "name": "n",
        "type": "integer",
        "reducer": {
          "kind": "add"
        },
        "scope": "thread",
        "description": "",
        "default": 0
      },
      {
        "name": "history",
        "type": "list",
        "reducer": {
          "kind": "keep_last_n",
          "n": 2
        },
        "scope": "thread",
        "description": "",
        "default": []
      },
      {
        "name": "turns",
        "type": "integer",
        "reducer": {
          "kind": "add"
        },
        "scope": "turn",
        "description": "",
        "default": 0
      },
      {
        "name": "answer",
        "type": "text",
        "reducer": {
          "kind": "replace"
        },
        "scope": "turn",
        "description": ""
      }
    ],
    "limits": {
      "maxSteps": 8,
      "maxModelCalls": 1,
      "maxTokens": 1024,
      "maxSeconds": 10
    }
  }
}
