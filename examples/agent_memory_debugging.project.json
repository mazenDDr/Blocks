{
  "schemaVersion": "1.0.0",
  "graphKind": "agent",
  "backend": "langgraph",
  "nodes": [
    {
      "id": "record_question",
      "type": "agent.memory_write",
      "version": "1.0.0",
      "config": {
        "target": "short_term",
        "field": "history",
        "role": "user",
        "text": "{question}",
        "mode": "direct"
      },
      "stateRef": null
    },
    {
      "id": "select",
      "type": "agent.memory_select",
      "version": "1.0.0",
      "config": {
        "policy": "lab_memory",
        "output_field": "memory",
        "short_term_field": "history"
      },
      "stateRef": null
    },
    {
      "id": "build_prompt",
      "type": "agent.prompt",
      "version": "1.0.0",
      "config": {
        "output_field": "prompt_messages",
        "items": [
          {
            "kind": "template",
            "role": "system",
            "template": "You are a laboratory assistant. Respect any recorded lab constraints in the notes."
          },
          {
            "kind": "memory",
            "role": "system",
            "field": "memory",
            "header": "Notes from long-term memory:",
            "template": "- ({id}) {text}"
          },
          {
            "kind": "template",
            "role": "user",
            "template": "{question}"
          }
        ]
      },
      "stateRef": null
    },
    {
      "id": "answer",
      "type": "agent.chat_model",
      "version": "1.0.0",
      "config": {
        "model": {
          "provider": "ollama",
          "model": "qwen3.5:2b",
          "temperature": 0.0,
          "max_tokens": 150,
          "seed": 7,
          "think": false
        },
        "messages_field": "prompt_messages",
        "output_field": "answer",
        "append_to": "history"
      },
      "stateRef": null
    }
  ],
  "edges": [
    {
      "id": "START__record_question",
      "kind": "control",
      "from": {
        "node": "START",
        "port": "out"
      },
      "to": {
        "node": "record_question",
        "port": "in"
      }
    },
    {
      "id": "record_question__select",
      "kind": "control",
      "from": {
        "node": "record_question",
        "port": "out"
      },
      "to": {
        "node": "select",
        "port": "in"
      }
    },
    {
      "id": "select__build_prompt",
      "kind": "control",
      "from": {
        "node": "select",
        "port": "out"
      },
      "to": {
        "node": "build_prompt",
        "port": "in"
      }
    },
    {
      "id": "build_prompt__answer",
      "kind": "control",
      "from": {
        "node": "build_prompt",
        "port": "out"
      },
      "to": {
        "node": "answer",
        "port": "in"
      }
    },
    {
      "id": "answer__END",
      "kind": "control",
      "from": {
        "node": "answer",
        "port": "out"
      },
      "to": {
        "node": "END",
        "port": "in"
      }
    }
  ],
  "agent": {
    "state": [
      {
        "name": "question",
        "type": "text",
        "reducer": {
          "kind": "replace"
        },
        "scope": "turn",
        "description": ""
      },
      {
        "name": "user_id",
        "type": "text",
        "reducer": {
          "kind": "replace"
        },
        "scope": "turn",
        "description": "",
        "default": "alice"
      },
      {
        "name": "memory",
        "type": "records",
        "reducer": {
          "kind": "replace"
        },
        "scope": "turn",
        "description": ""
      },
      {
        "name": "history",
        "type": "messages",
        "reducer": {
          "kind": "append"
        },
        "scope": "thread",
        "description": ""
      },
      {
        "name": "prompt_messages",
        "type": "list",
        "reducer": {
          "kind": "replace"
        },
        "scope": "turn",
        "description": ""
      },
      {
        "name": "answer",
        "type": "text",
        "reducer": {
          "kind": "replace"
        },
        "scope": "turn",
        "description": ""
      }
    ],
    "limits": {
      "maxSteps": 20,
      "maxModelCalls": 4
    },
    "policies": [
      {
        "id": "lab_memory",
        "name": "Lab memory selection",
        "description": "Which stored notes reach the model: eligible records -> rank -> token budget.",
        "query": "{question}",
        "embeddings": {
          "provider": "local_hash",
          "dimension": 512
        },
        "stages": [
          {
            "id": "eligible",
            "op": "retrieve",
            "config": {
              "sources": [
                "long_term"
              ],
              "namespaces": [
                "lab"
              ],
              "scopes": [
                "user:{user_id}"
              ],
              "method": "all"
            }
          },
          {
            "id": "rank",
            "op": "rank",
            "config": {
              "weights": {
                "recency": 1.0,
                "relevance": 0.2,
                "importance": 0.1
              },
              "half_life_days": 14,
              "limit": 3
            }
          },
          {
            "id": "budget",
            "op": "budget",
            "config": {
              "max_tokens": 120,
              "overflow": "stop",
              "order": "rank"
            }
          }
        ]
      }
    ]
  }
}
